{
  "name": "dat-ia-session-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only OpenCode session observability dashboard: read-only SQLite adapter plus Vite/React SPA.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "api": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:client && npm run test:server",
    "test:client": "vitest run",
    "test:server": "node --test 'server/**/*.test.ts'"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
